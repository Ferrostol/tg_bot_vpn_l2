# Сборка для фикса xl2tpd на alpine
FROM alpine:3.23 AS builder
ARG XL2TPD_VERSION=1.3.20

RUN apk add --no-cache build-base linux-headers libpcap-dev wget tar

WORKDIR /usr/src

RUN wget -O xl2tpd.tar.gz "https://github.com/xelerance/xl2tpd/archive/refs/tags/v${XL2TPD_VERSION}.tar.gz" \
    && tar -xzf xl2tpd.tar.gz && mv "xl2tpd-${XL2TPD_VERSION}" xl2tpd && rm xl2tpd.tar.gz

WORKDIR /usr/src/xl2tpd

RUN make clean && make -j4 DFLAGS="-DDEBUG_PPPD -DTRUST_PPPD_TO_DIE" \
    && install -D -m 0755 xl2tpd /out/usr/sbin/xl2tpd \
    && install -D -m 0755 xl2tpd-control /out/usr/sbin/xl2tpd-control
# Конец сборки фикса

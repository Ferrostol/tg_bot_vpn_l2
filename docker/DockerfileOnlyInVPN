FROM hwdsl2/ipsec-vpn-server
WORKDIR /opt/src

RUN TMP_FILE="$(mktemp)" \
    && awk '/cat[[:space:]]*(>|>>)[[:space:]]*\/etc\/ppp\/chap-secrets/&&!f{print "if [ ! -s /etc/ppp/chap-secrets ]; then";f=1;next} /cat[[:space:]]*>[[:space:]]*\/etc\/xl2tpd\/xl2tpd\.conf/{x=1} /^[[:space:]]*EOF[[:space:]]*$/&&f{print "fi";f=0} /^[[:space:]]*EOF[[:space:]]*$/&&x{print;print "cat /etc/xl2tpd/configs/*.conf >> /etc/xl2tpd/xl2tpd.conf";x=0;next} {print}' /opt/src/run.sh > "$TMP_FILE" \
    && chmod --reference=/opt/src/run.sh "$TMP_FILE" \
    && cat "$TMP_FILE" > /opt/src/run.sh \
    && rm -f "$TMP_FILE" \
    && sed -i '/^conn ikev2-cp$/a\  leftupdown=/opt/src/iptables_setup.sh' ikev2.sh \
    && sed -i "s|Disconnect|Сonnect|g" ikev2.sh


CMD ["/opt/src/run.sh"]
{
  "log": {
    "level": "fatal"
  },
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "l2tp-in",
      "listen": "127.0.0.1",
      "listen_port": 12345
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "inet"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "l2tp-in",
        "action": "sniff"
      },
      {
        "inbound": "l2tp-in",
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "inbound": "l2tp-in",
        "outbound": "inet"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ]
  }
}